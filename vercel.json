{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});['index.html','live.html','manifest.webmanifest','sw.js','logo.png','live-brand-icon.png'].forEach(f=>fs.copyFileSync('ai/'+f,'public/'+f));console.log('AI_WINE_COACH_BUILD_DONE')\"",
  "functions": {
    "api/coach-chat.js": {
      "includeFiles": "maenads_system_prompt.md",
      "maxDuration": 60
    },
    "api/chat.js": {
      "includeFiles": "maenads_system_prompt.md",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/live/live-brand-icon.png",
      "destination": "/live-brand-icon.png"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/live/",
      "destination": "/live.html"
    },
    {
      "source": "/.netlify/functions/coach-chat",
      "destination": "/api/coach-chat"
    }
  ],
  "headers": [
    {
      "source": "/live",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/live/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
